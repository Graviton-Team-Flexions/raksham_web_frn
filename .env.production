# Public address of the deployed API (not a secret). Vite reads this file during `npm run build`,
# so the deployed site knows where Sachi lives without any dashboard setting.
VITE_API_BASE_URL=https://raksham-api.onrender.com/api/v1

# DEMO ONLY: turns on the temporary demo login (test@gmail.com / test123) in the deployed site.
# These values are readable in the shipped JavaScript. Set to false (or delete this line) before real users arrive.
VITE_ENABLE_TEST_LOGIN=true
